<!-- PURPOSE: Defines cloud Firestore authorization and zero-knowledge database access control rules. -->
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper functions ──────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Check if the requesting user is an active member of a collection.
    // Reads the members sub-document directly (consistent with Firestore security).
    function isActiveMember(collectionId) {
      let memberDoc = get(/databases/$(database)/documents/collections/$(collectionId)/members/$(request.auth.uid));
      return memberDoc.data.status == 'active';
    }

    // Check if member has a specific role or higher.
    // Roles in ascending order: viewer < editor < manager < owner
    function hasRole(collectionId, minRole) {
      let memberDoc = get(/databases/$(database)/documents/collections/$(collectionId)/members/$(request.auth.uid));
      let role = memberDoc.data.role;
      return memberDoc.data.status == 'active' && (
        minRole == 'viewer' ||
        (minRole == 'editor' && role in ['editor', 'manager', 'owner']) ||
        (minRole == 'manager' && role in ['manager', 'owner']) ||
        (minRole == 'owner' && role == 'owner')
      );
    }

    // ─── Existing: Per-user personal data ──────────────────────────────────

    match /users/{userId}/{document=**} {
      allow read, write: if isSignedIn() && isOwner(userId);
    }

    // ─── Existing: Username reservation ────────────────────────────────────

    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
        && resource.data.uid == request.auth.uid;
    }

    // ─── Existing: Email enumeration protection ─────────────────────────────

    match /registered_emails/{hash} {
      allow get: if true;
      allow create: if isSignedIn();
    }

    // ─── Existing: App config ───────────────────────────────────────────────

    match /app_config/{document=**} {
      allow read: if true;
    }

    // ─── New: Collections (Client-Side Rewrite for Free Plan) ───────────────
    // Since Firebase Functions require the Blaze plan, we have moved the sharing
    // logic to the client. These rules enforce access control for client writes.

    match /collections/{collectionId} {
      allow read: if isSignedIn() && isActiveMember(collectionId);
      allow create: if isSignedIn() && request.resource.data.owner_user_id == request.auth.uid;
      allow update: if isSignedIn() && isActiveMember(collectionId) && hasRole(collectionId, 'editor');

      // ── Members sub-collection ───────────────────────────────────────────
      match /members/{userId} {
        allow read: if isSignedIn() && isActiveMember(collectionId);
        // Allow members to manage roles, or users to join if they accept an invite.
        allow write: if isSignedIn() && (isActiveMember(collectionId) || request.auth.uid == userId);
      }

      // ── Invites sub-collection ───────────────────────────────────────────
      match /invites/{inviteId} {
        allow read, write: if isSignedIn() && (
          resource == null ||
          resource.data.invited_user_id == request.auth.uid ||
          resource.data.invited_by_user_id == request.auth.uid ||
          isActiveMember(collectionId)
        );
      }

      // ── Collection Items ─────────────────────────────────────────────────
      match /items/{itemId} {
        allow read: if isSignedIn() && isActiveMember(collectionId);
        allow write: if isSignedIn() && hasRole(collectionId, 'editor');
      }

      // ── Key Envelopes ────────────────────────────────────────────────────
      match /keyEnvelopes/{recipientId} {
        allow read: if isSignedIn() && recipientId == request.auth.uid;
        // The sender writes the envelope when inviting. The recipient updates it when accepting.
        allow write: if isSignedIn() && (recipientId == request.auth.uid || isActiveMember(collectionId));
      }

      // ── Sync Events ──────────────────────────────────────────────────────
      match /syncEvents/{eventId} {
        allow read: if isSignedIn() && isActiveMember(collectionId);
        allow write: if isSignedIn() && isActiveMember(collectionId);
      }
    }

    // ─── New: folder_shares pivot collection ─────────────────────────────
    match /folder_shares/{shareId} {
      allow read: if isSignedIn() && (
        resource == null || resource.data.user_id == request.auth.uid
      );
      allow write: if isSignedIn() && (
        // Allow user to write their own share
        (request.resource != null && request.resource.data.user_id == request.auth.uid) ||
        (resource != null && resource.data.user_id == request.auth.uid) ||
        // Allow active member of the folder to write
        (request.resource != null && isActiveMember(request.resource.data.folder_id)) ||
        (resource != null && isActiveMember(resource.data.folder_id))
      );
    }

    // ─── New: User notifications ─────────────────────────────────────────────
    // Users can read and mark-read their own notifications.
    // Cloud Functions create notifications (write is via Admin SDK).

    match /users/{userId}/notifications/{notificationId} {
      allow read: if isSignedIn() && isOwner(userId);
      // Allow owner to mark as read (status, is_read, read_at fields).
      allow update: if isSignedIn() && isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['is_read', 'read_at', 'status']);
      // Allow any signed-in user to create an invite notification for another user,
      // as long as they identify themselves as the sender (no Cloud Functions on Spark plan).
      allow create: if isSignedIn()
        && request.resource.data.type == 'invite_received'
        && request.resource.data.sender_uid == request.auth.uid;
      allow delete: if false;
    }

    // ─── New: Audit Events ───────────────────────────────────────────────────
    // Read-only for admin/Cloud Function use. No client access.

    match /auditEvents/{eventId} {
      allow read, write: if false;
    }

    // ─── New: Security Events ────────────────────────────────────────────────
    // Read-only for admin/Cloud Function use. No client access.

    match /securityEvents/{eventId} {
      allow read, write: if false;
    }

    // ─── New: Rate Limit Counters (Cloud Function internal) ─────────────────

    match /rateLimits/{document=**} {
      allow read, write: if false;
    }

    // ─── New: Invite Cooldowns (Cloud Function internal) ─────────────────────

    match /inviteCooldowns/{document=**} {
      allow read, write: if false;
    }

    // ─── New: Public user profiles (display name, avatar for invite UI) ──────
    // Any authenticated user may read minimal public profile fields.
    // Users write their own profile (username, display_name, avatar_url).

    match /userProfiles/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isOwner(userId);
    }
  }
}
