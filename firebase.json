{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firestore-debug.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "auth": {
    "providers": {
      "emailPassword": true,
      "googleSignIn": {
        "oAuthBrandDisplayName": "SecureVault",
        "supportEmail": "mohdjamal1110@gmail.com"
      }
    }
  },
  "hosting": {
    "public": "ota-updates",
    "ignore": ["firebase.json", "**/.*", "**/*.apk"],
    "headers": [
      {
        "source": "**/*.zip",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "Content-Type", "value": "application/zip" }
        ]
      }
    ]
  }
}